    "primevue": "^5.0.4",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@babel/types": "^8.1.0",
    "@primevue/auto-import-resolver": "^5.0.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.3.5",

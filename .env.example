# Copy this file to .env and adjust the values for your local environment.
# .env is gitignored and must never be committed.

# Controls which database path is used by the app and the seed command.
# Set to "development" to use inventario_dev.db in the working directory.
# Leave unset (or any other value) to use the production path under UserConfigDir.
ENV=development

# Optional: override the database file path explicitly.
# When set, this takes precedence over ENV in both the app and the seed command.
# DB_PATH=inventario_dev.db
